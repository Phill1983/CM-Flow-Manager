    "poc:unlock": "node ./scripts/unlock-poc.mjs"
  },
  "dependencies": {
    "@cm-flow-manager/file-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
