{
  "name": "@cm-flow-manager/pdf-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./page-range": {
      "types": "./src/page-range.ts",
      "import": "./src/page-range.ts",
      "default": "./src/page-range.ts"
    }
  },
  "scripts": {
