{
  "name": "cm-flow-manager",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "description": "A modular local-first desktop toolkit for PDF and workflow operations.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cm-flow-manager/desktop dev",
    "build": "pnpm -r --filter @cm-flow-manager/desktop... build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pdf": "vitest run packages/pdf-engine",
    "fetch:qpdf": "node ./scripts/fetch-qpdf-dev.mjs",
    "fixtures:pdf": "pnpm --filter @cm-flow-manager/pdf-engine generate:fixtures",
    "pack:win": "pnpm fetch:qpdf && pnpm build && pnpm --filter @cm-flow-manager/desktop dist:win && pnpm release:checksums",
    "release:checksums": "node ./scripts/write-release-checksums.mjs",
    "clean": "pnpm -r exec rimraf dist out coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
