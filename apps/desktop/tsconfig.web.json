{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@cm-flow-manager/ipc-contracts": ["../../packages/ipc-contracts/src/index.ts"],
      "@cm-flow-manager/pdf-engine": ["../../packages/pdf-engine/src/index.ts"],
      "@cm-flow-manager/pdf-password-remover": ["../../modules/pdf-password-remover/src/index.ts"],
      "@cm-flow-manager/pdf-split-merge": ["../../modules/pdf-split-merge/src/index.ts"],
      "@cm-flow-manager/pdf-engine/page-range": ["../../packages/pdf-engine/src/page-range.ts"],
      "@cm-flow-manager/file-utils": ["../../packages/file-utils/src/index.ts"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*",
    "../../packages/ipc-contracts/src/**/*.ts",
    "../../packages/pdf-engine/src/**/*.ts",
    "../../packages/file-utils/src/**/*.ts",
    "../../modules/pdf-password-remover/src/**/*.ts",
    "../../modules/pdf-split-merge/src/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
