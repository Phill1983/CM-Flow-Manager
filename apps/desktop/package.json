{
  "name": "@cm-flow-manager/desktop",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "CM Flow Manager — local PDF Password Remover",
  "author": {
    "name": "CM Flow Manager"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cm-flow-manager/app-updater build && electron-vite dev",
    "build": "electron-vite build && node ./scripts/assert-main-bundle.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "preview": "electron-vite preview",
    "test": "vitest run --passWithNoTests",
    "dist:win": "node ../../scripts/ensure-qpdf-for-pack.mjs && node ../../scripts/run-electron-builder-win.mjs"
  },
  "dependencies": {
    "@cm-flow-manager/app-updater": "workspace:^",
    "@cm-flow-manager/file-utils": "workspace:*",
    "@cm-flow-manager/ipc-contracts": "workspace:*",
    "@cm-flow-manager/pdf-engine": "workspace:*",
    "@cm-flow-manager/pdf-password-remover": "workspace:*",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.8.2",
    "vite": "^6.4.3"
  }
}
